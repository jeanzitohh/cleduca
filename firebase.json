{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/admin/**",
        "destination": "/admin/index.html"
      },
      {
        "source": "/app/**",
        "destination": "/app/index.html"
      },
      {
        "source": "/privacidad",
        "destination": "/privacidad.html"
      },
      {
        "source": "/terminos",
        "destination": "/terminos.html"
      },
      {
        "source": "/",
        "destination": "/index.html"
      }
    ]
  }
}

